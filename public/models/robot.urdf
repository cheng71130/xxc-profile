<?xml version="1.0"?>
<robot name="industrial_robot">

  <!-- 🔧 Base Link - 机器人底座 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Base.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Base.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <!-- 🔧 J1 Link - 第1关节连杆 -->
  <link name="j1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J1.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J1.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 1 - 底座到J1的旋转关节 -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="j1_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
  </joint>

  <!-- 🔧 J2 Link - 第2关节连杆 -->
  <link name="j2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J2.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J2.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="18.0"/>
      <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 2 - J1到J2的旋转关节 -->
  <joint name="joint_2" type="revolute">
    <parent link="j1_link"/>
    <child link="j2_link"/>
    <origin xyz="0.2 0 0.8" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="150.0" velocity="2.0"/>
  </joint>

  <!-- 🔧 J3 Link - 第3关节连杆 -->
  <link name="j3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J3.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J3.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 3 - J2到J3的旋转关节 -->
  <joint name="joint_3" type="revolute">
    <parent link="j2_link"/>
    <child link="j3_link"/>
    <origin xyz="0.6 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09" upper="2.09" effort="100.0" velocity="2.5"/>
  </joint>

  <!-- 🔧 J4 Link - 第4关节连杆 -->
  <link name="j4_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J4.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J4.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12.0"/>
      <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 4 - J3到J4的旋转关节 -->
  <joint name="joint_4" type="revolute">
    <parent link="j3_link"/>
    <child link="j4_link"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="80.0" velocity="3.0"/>
  </joint>

  <!-- 🔧 J5 Link - 第5关节连杆 -->
  <link name="j5_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J5.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J5.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.15" ixy="0.0" ixz="0.0" iyy="0.15" iyz="0.0" izz="0.15"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 5 - J4到J5的旋转关节 -->
  <joint name="joint_5" type="revolute">
    <parent link="j4_link"/>
    <child link="j5_link"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09" upper="2.09" effort="60.0" velocity="3.5"/>
  </joint>

  <!-- 🔧 J6 Link - 第6关节连杆（末端执行器） -->
  <link name="j6_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J6.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="J6.obj"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- ⚙️ Joint 6 - J5到J6的旋转关节 -->
  <joint name="joint_6" type="revolute">
    <parent link="j5_link"/>
    <child link="j6_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="40.0" velocity="4.0"/>
  </joint>

  <!-- 🎯 末端执行器坐标系 (可选) -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 0.8"/>
      </material>
    </visual>
  </link>

  <!-- <joint name="end_effector_joint" type="fixed">
    <parent link="j6_link"/>
    <child link="end_effector"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
  </joint> -->

  <!-- 🎨 材质定义 -->
  <material name="robot_gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="robot_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <material name="robot_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

</robot>