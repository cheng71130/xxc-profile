{
	"type": "module",
	"name": "xxc_vite_vue3",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --open",
		"build": "vue-tsc -b && vite build",
		"electron:dev": "cross-env ELECTRON_ENABLE=true vite --no-open & electron .",
		"electron:build": "vue-tsc && vite build && electron-builder",
		"preview": "vite preview"
	},
	"main": "dist-electron/main.js",
	"build": {
		"appId": "com.yourapp.id",
		"productName": "xxc_website",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"dist-electron/**/*"
		],
		"mac": {
			"category": "public.app-category.utilities",
			"icon": "public/electron/icon.png"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "public/electron/icon.png"
		},
		"linux": {
			"target": [
				"deb",
				"AppImage"
			],
			"icon": "public/electron/icon.png"
		}
	},
	"dependencies": {
		"@antv/layout": "1.2.14-beta.6",
		"@element-plus/icons-vue": "^2.3.1",
		"@kjgl77/datav-vue3": "^1.6.1",
		"@logicflow/core": "^2.0.3",
		"@logicflow/extension": "^2.0.6",
		"@logicflow/vue-node-registry": "^1.0.3",
		"@vueuse/core": "^13.1.0",
		"aos": "^2.3.4",
		"autofit.js": "^3.2.2",
		"echarts": "^5.4.3",
		"element-plus": "^2.7.6",
		"three": "^0.174.0",
		"typeit": "^8.8.7",
		"vue": "^3.4.37",
		"vue-router": "^4.2.5"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.1.2",
		"@vue/tsconfig": "^0.7.0",
		"cross-env": "^7.0.3",
		"electron": "^36.2.1",
		"electron-builder": "^26.0.12",
		"less": "^4.2.0",
		"less-loader": "^11.1.3",
		"sass": "^1.89.0",
		"typescript": "^5.5.3",
		"unocss": "66.1.0-beta.12",
		"unplugin-auto-import": "^0.18.2",
		"vite": "^6.3.5",
		"vite-plugin-electron": "^0.29.0",
		"vite-plugin-vue-inspector": "^5.2.0",
		"vue-tsc": "^2.0.29"
	}
}
